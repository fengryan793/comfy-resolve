{
  "_comment": "Working Comfy Cloud RED reference-to-video, 5s. POST this as {\"prompt\": <this>} to https://cloud.comfy.org/api/prompt with Authorization: Bearer <firebase-jwt>. unet_name is the imported name (hf-user__hf-repo__file). LoRA/clip/VAEs are pre-installed on Comfy Cloud. Reference image must be uploaded first via /api/upload/image; put its returned name in img.inputs.image.",
  "unet": {"class_type": "UNETLoader", "inputs": {"unet_name": "jasperz111__redcraft-minimax-h3-a2a-redmix__redcraftMinimaxH3REDMIX_h3A2AREDMinimax.safetensors", "weight_dtype": "default"}},
  "lora": {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["unet", 0], "lora_name": "minimax_h3_turbo_v4_step600_ema_pruned_comfyui.safetensors", "strength_model": 1.0}},
  "clip": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default"}},
  "vvae": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"}},
  "avae": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"}},
  "img": {"class_type": "LoadImage", "inputs": {"image": "<uploaded-ref-image-name>.jpg"}},
  "noise": {"class_type": "RandomNoise", "inputs": {"noise_seed": 7}},
  "sched": {"class_type": "BasicScheduler", "inputs": {"model": ["lora", 0], "scheduler": "beta", "steps": 8, "denoise": 1.0}},
  "samp": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler"}},
  "h3": {"class_type": "MiniMaxH3ReferenceToVideo", "inputs": {"clip": ["clip", 0], "vae": ["vvae", 0], "audio_vae": ["avae", 0], "prompt": "<Picture 1> The same young woman, photorealistic, exact identity preserved. She smiles warmly and turns her head toward the camera, soft cinematic lighting, gentle breeze in her hair.", "width": 1344, "height": 768, "length": 121, "ref_image_size": "match", "ref_images.ref_image_0": ["img", 0]}},
  "guider": {"class_type": "BasicGuider", "inputs": {"model": ["lora", 0], "conditioning": ["h3", 0]}},
  "ks": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["noise", 0], "guider": ["guider", 0], "sampler": ["samp", 0], "sigmas": ["sched", 0], "latent_image": ["h3", 1]}},
  "vdec": {"class_type": "VAEDecode", "inputs": {"samples": ["ks", 0], "vae": ["vvae", 0]}},
  "adec": {"class_type": "VAEDecodeAudio", "inputs": {"samples": ["ks", 0], "vae": ["avae", 0]}},
  "cv": {"class_type": "CreateVideo", "inputs": {"images": ["vdec", 0], "audio": ["adec", 0], "fps": 24}},
  "out": {"class_type": "SaveVideo", "inputs": {"video": ["cv", 0], "filename_prefix": "cc_RED_5s", "format": "auto", "codec": "auto"}}
}
